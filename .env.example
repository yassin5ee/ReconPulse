# Copy to .env or export in your shell. Prefix: RECONPULSE_
RECONPULSE_DATABASE_URL=postgresql+psycopg2://reconpulse:reconpulse@localhost:5432/reconpulse
RECONPULSE_LOG_LEVEL=INFO
RECONPULSE_TOOL_TIMEOUT=300
RECONPULSE_HTTP_PROBE_TIMEOUT=10
RECONPULSE_DNS_TIMEOUT=5
RECONPULSE_WORKER_POLL_INTERVAL=2
RECONPULSE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Never put provider API keys here in production; use a secret manager.
